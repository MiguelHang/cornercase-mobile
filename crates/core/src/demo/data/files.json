      },
      {
        "path": "Sources/WeatherKit/Forecast.swift",
        "lines": [
          "public struct Forecast: Sendable {",
          "    public let city: String",
          "    public let hours: [Double]",
          "}"
        ]
      },
      {
        "path": "Sources/WeatherKit/ForecastCache.swift",
        "lines": [
          "import Foundation",
          "",
          "actor ForecastCache {",
          "    private var kept: [String: (Forecast, Date)] = [:]",
          "",
          "    func forecast(for city: String) -> Forecast? {",
          "        guard let (forecast, at) = kept[city], at.timeIntervalSinceNow > -600 else { return nil }",
          "        return forecast",
          "    }",
          "",
          "    func keep(_ forecast: Forecast) {",
          "        kept[forecast.city] = (forecast, Date())",
          "    }",
          "}"
        ]
      },
      {
        "path": "Tests/WeatherKitTests/ForecastCacheTests.swift",
        "lines": [
          "import Testing",
          "@testable import WeatherKit",
          "",
          "@Test func keepsAForecast() async {",
          "    let cache = ForecastCache()",
          "    await cache.keep(Forecast(city: \"Lisbon\", hours: [18]))",
          "    #expect(await cache.forecast(for: \"Lisbon\") != nil)",
          "}"
        ]
